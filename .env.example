# ─────────────────────────────────────────────
# Banco de dados (Supabase)
# ─────────────────────────────────────────────
# Pooled — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.xxxx:password@aws-x-us-east-1.pooler.supabase.com:6543/postgres"
# Direto — usado pelo prisma migrate
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# Supabase Storage
# ─────────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."  # Supabase Dashboard → Settings → API → service_role (secret)

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
NEXTAUTH_URL="https://sauu.vercel.app"
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# ─────────────────────────────────────────────
# Stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."            # Dashboard Stripe → Developers → API keys
STRIPE_WEBHOOK_SECRET="whsec_..."         # Dashboard Stripe → Developers → Webhooks
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# URL base da aplicação (usada em links de webhook e emails)
NEXT_PUBLIC_BASE_URL="https://sauu.vercel.app"

# ─────────────────────────────────────────────
# Email — Resend (substitui Nodemailer/Gmail)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_..."           # resend.com → API Keys → Create API Key
EMAIL_FROM="SAUU Unifil <noreply@seudominio.com.br>"  # Domínio verificado no Resend

# ─────────────────────────────────────────────
# Evento
# ─────────────────────────────────────────────
EVENT_REGISTRATION_PRICE="50.00"

# ─────────────────────────────────────────────
# Alertas de sistema
# ─────────────────────────────────────────────
ADMIN_ALERT_EMAIL="email@dominio.com"

# ─────────────────────────────────────────────
# Cron (limpeza de tokens expirados)
# ─────────────────────────────────────────────
CRON_SECRET=""  # openssl rand -base64 32 — usado em GET /api/admin/cleanup
