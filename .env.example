# ─────────────────────────────────────────────
# Banco de dados (Supabase)
# ─────────────────────────────────────────────
# Pooled — usado pelo app em runtime
DATABASE_URL="postgresql://postgres.xxxx:password@aws-x-us-east-1.pooler.supabase.com:6543/postgres"
# Direto — usado pelo prisma migrate
DIRECT_URL="postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres"

# ─────────────────────────────────────────────
# Supabase Storage
# ─────────────────────────────────────────────
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGci..."  # Supabase Dashboard → Settings → API → service_role (secret)

# ─────────────────────────────────────────────
# NextAuth
# ─────────────────────────────────────────────
NEXTAUTH_URL="https://sauuclbb.com"
NEXTAUTH_SECRET=""  # openssl rand -base64 32

# ─────────────────────────────────────────────
# Mercado Pago (PIX — inscrições no evento)
# ─────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."     # Mercado Pago → Suas integrações → sua app → Credenciais de produção → Access Token
MERCADOPAGO_WEBHOOK_SECRET=""              # (opcional, recomendado) Mercado Pago → Webhooks → "Assinatura secreta" (valida o x-signature)

# ─────────────────────────────────────────────
# Stripe (cartão — produtos da loja)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_..."           # Stripe → Developers → API keys → Secret key
STRIPE_WEBHOOK_SECRET="whsec_..."         # Stripe → Developers → Webhooks → endpoint /api/pagamento/webhook → Signing secret

# URL base da aplicação (usada em links de webhook e emails)
NEXT_PUBLIC_BASE_URL="https://sauuclbb.com"

# ─────────────────────────────────────────────
# Email — Resend (substitui Nodemailer/Gmail)
# ─────────────────────────────────────────────
RESEND_API_KEY="re_..."           # resend.com → API Keys → Create API Key
EMAIL_FROM="SAUU CLBB <noreply@sauuclbb.com>"  # Domínio verificado no Resend

# ─────────────────────────────────────────────
# Evento
# ─────────────────────────────────────────────
EVENT_REGISTRATION_PRICE="50.00"

# ─────────────────────────────────────────────
# Alertas de sistema
# ─────────────────────────────────────────────
ADMIN_ALERT_EMAIL="email@dominio.com"

# ─────────────────────────────────────────────
# Cron (limpeza de tokens expirados)
# ─────────────────────────────────────────────
CRON_SECRET=""  # openssl rand -base64 32 — usado em GET /api/admin/cleanup
