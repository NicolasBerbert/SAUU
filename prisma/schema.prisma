generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserType {
  UNIFIL   // Aluno da Unifil (@edu.unifil.br)
  UEL      // Aluno da UEL
  FORMADO  // Já formado
  ADMIN
}

enum SlotTime {
  SLOT_19H00  // 19:00
  SLOT_20H45  // 20:45
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

// ─────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String
  password      String
  institution   String
  type          UserType
  emailVerified Boolean   @default(false)
  active        Boolean   @default(true)
  totpSecret    String?   // TOTP 2FA (apenas ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  eventRegistration    EventRegistration?
  presentationSlots    PresentationSlot[]
  orders               Order[]
  certificate          Certificate?
  emailVerificationTokens EmailVerificationToken[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([type])
}

// ─────────────────────────────────────────────
// VERIFICAÇÃO DE EMAIL
// ─────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // hash SHA-256 do token enviado por e-mail
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// EVENTO
// ─────────────────────────────────────────────

model EventRegistration {
  id            String        @id @default(cuid())
  userId        String        @unique
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  amount        Decimal       @db.Decimal(10, 2)
  attendedAt    DateTime?     // Preenchido no check-in do dia do evento
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// PALESTRAS
// ─────────────────────────────────────────────

model Presentation {
  id          String   @id @default(cuid())
  title       String
  speaker     String
  bio         String?
  imageUrl    String?
  day         Int
  slot        SlotTime
  maxCapacity Int      @default(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slots PresentationSlot[]

  @@unique([day, slot])
  @@index([day])
}

model PresentationSlot {
  id             String   @id @default(cuid())
  userId         String
  presentationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  presentation Presentation @relation(fields: [presentationId], references: [id])

  @@unique([userId, presentationId])
  @@index([presentationId])
}

// ─────────────────────────────────────────────
// LOJA
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  paymentId String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────
// CERTIFICADOS (apenas para alunos UEL)
// ─────────────────────────────────────────────

model Certificate {
  id       String   @id @default(cuid())
  userId   String   @unique
  issuedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// AUDIT LOG — rastreio de ações financeiras e admin
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null para eventos de sistema/webhook
  actorType  String   // "USER" | "ADMIN" | "SYSTEM" | "WEBHOOK"
  action     String   // ex: "PAYMENT_APPROVED", "PRODUCT_UPDATED"
  entityId   String?  // ID do registro afetado
  entityType String?  // ex: "EventRegistration", "Order", "Product"
  metadata   Json?    // contexto adicional (sem dados pessoais)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
