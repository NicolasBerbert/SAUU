generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserType {
  UNIFIL   // Aluno da Unifil (@edu.unifil.br)
  EXTERNO  // Aluno de instituição externa (outras faculdades de arquitetura)
  FORMADO  // Já formado
  ADMIN
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

// ─────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String
  password      String
  institution   String
  type          UserType
  cpf           String?   // CPF — coletado no cadastro
  ra            String?   // Registro Acadêmico (apenas EXTERNO)
  emailVerified Boolean   @default(false)
  active        Boolean   @default(true)
  totpSecret    String?   // TOTP 2FA (apenas ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  eventRegistration    EventRegistration?
  presentationSlots    PresentationSlot[]
  orders               Order[]
  certificate          Certificate?
  emailVerificationTokens EmailVerificationToken[]
  auditLogs            AuditLog[]

  @@index([email])
  @@index([type])
}

// ─────────────────────────────────────────────
// VERIFICAÇÃO DE EMAIL
// ─────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // hash SHA-256 do token enviado por e-mail
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─────────────────────────────────────────────
// EVENTO
// ─────────────────────────────────────────────

model EventRegistration {
  id            String        @id @default(cuid())
  userId        String        @unique
  paymentStatus PaymentStatus @default(PENDING)
  paymentId     String?
  amount        Decimal       @db.Decimal(10, 2)
  attendedAt    DateTime?     // Preenchido no check-in do dia do evento
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// COMISSÃO
// ─────────────────────────────────────────────

model ComissaoMember {
  id        String   @id @default(cuid())
  name      String
  role      String?
  imageUrl  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PATROCINADORES
// ─────────────────────────────────────────────

model Patrocinador {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  tier      String?  // ex: "Ouro", "Prata", "Bronze"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PALESTRANTES
// ─────────────────────────────────────────────

model Palestrante {
  id        String   @id @default(cuid())
  name      String
  bio       String?
  imageUrl  String?
  role      String?  // ex: "Arquiteta e Urbanista", "Engenheiro Civil"
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  presentations PresentationSpeaker[]
}

// ─────────────────────────────────────────────
// PALESTRAS
// ─────────────────────────────────────────────

model Presentation {
  id             String   @id @default(cuid())
  title          String
  speaker        String   // nomes dos palestrantes combinados (denormalizado, para exibição)
  bio            String?
  imageUrl       String?
  day            Int
  slot           String   // horário livre, ex: "19:00", "20:30"
  duration       Int      @default(90) // duração em minutos
  maxCapacity    Int      @default(100)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  speakers PresentationSpeaker[]
  slots    PresentationSlot[]

  @@index([day])
}

// Vínculo N:N entre uma palestra e seus palestrantes (roda de conversa,
// mesa redonda etc. — mais de um palestrante por palestra).
model PresentationSpeaker {
  presentationId String
  palestranteId  String
  order          Int    @default(0) // ordem de exibição dos nomes

  presentation Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  palestrante  Palestrante  @relation(fields: [palestranteId], references: [id], onDelete: Cascade)

  @@id([presentationId, palestranteId])
  @@index([palestranteId])
}

model PresentationSlot {
  id             String    @id @default(cuid())
  userId         String
  presentationId String
  attendedAt     DateTime? // preenchido pelo admin no dia da palestra
  createdAt      DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id])
  presentation Presentation @relation(fields: [presentationId], references: [id])

  @@unique([userId, presentationId])
  @@index([presentationId])
}

// ─────────────────────────────────────────────
// LOJA
// ─────────────────────────────────────────────

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  stock       Int      @default(0)
  imageUrl    String?
  sizes       String?  // comma-separated size options, e.g. "P,M,G,GG"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  total     Decimal     @db.Decimal(10, 2)
  status    OrderStatus @default(PENDING)
  paymentId String?
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

// ─────────────────────────────────────────────
// CERTIFICADOS (apenas para alunos de instituição externa)
// ─────────────────────────────────────────────

model Certificate {
  id       String   @id @default(cuid())
  userId   String   @unique
  issuedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────
// CONFIGURAÇÕES DO SITE
// ─────────────────────────────────────────────

model SiteConfig {
  key   String @id
  value String
}

// ─────────────────────────────────────────────
// IDEMPOTÊNCIA DO WEBHOOK STRIPE
// ─────────────────────────────────────────────

model ProcessedStripeEvent {
  id          String   @id // Stripe event ID (evt_xxx)
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─────────────────────────────────────────────
// AUDIT LOG — rastreio de ações financeiras e admin
// ─────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  // null para eventos de sistema/webhook
  actorType  String   // "USER" | "ADMIN" | "SYSTEM" | "WEBHOOK"
  action     String   // ex: "PAYMENT_APPROVED", "PRODUCT_UPDATED"
  entityId   String?  // ID do registro afetado
  entityType String?  // ex: "EventRegistration", "Order", "Product"
  metadata   Json?    // contexto adicional (sem dados pessoais)
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
